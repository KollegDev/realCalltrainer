# Copy this file to ".env" and paste your Gemini API key.
# Get a free key at: https://aistudio.google.com/apikey
#
# NOTE: This key is embedded in the browser bundle. That is fine for LOCAL,
# single-user practice. Do NOT deploy this app publicly with the key in here
# (see README "Deploying later" for the ephemeral-token upgrade).

VITE_GEMINI_API_KEY=paste-your-key-here
